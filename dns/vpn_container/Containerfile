FROM quay.io/centos/centos:stream10
RUN dnf --assumeyes install epel-release \
 && dnf --assumeyes install bind-utils curl dbus-broker iproute iputils jq \
      openssl procps-ng qbittorrent-nox systemd systemd-resolved \
      wireguard-tools \
 && dnf clean all
RUN systemctl enable dbus-broker.service systemd-resolved.service \
 && useradd --create-home qbt
COPY resolved.conf /etc/systemd/resolved.conf.d/90-dotfiles-dns.conf
COPY --chmod=0755 vpn_container/cell_probe.sh /usr/local/bin/cell_probe.sh
CMD ["/sbin/init"]
