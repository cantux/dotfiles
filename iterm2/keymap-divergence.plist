<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Our only divergence from iTerm2's default global key map.
  Makes Ctrl+Enter and Shift+Enter send distinct escape sequences so apps
  (Claude Code) can tell them apart from plain Enter, which sends bare \r.

  These are CSI u (fixterms) sequences. Action 10 = "Send Escape Sequence",
  so iTerm2 prepends ESC to Text:
    0xd-0x40000-0x24  Ctrl+Enter  -> ESC [13;5u   (mod 5 = 1+4 = Ctrl)
    0xd-0x20000-0x24  Shift+Enter -> ESC [13;2u   (mod 2 = 1+1 = Shift)
  Key id format: <char>-<modifier flags>-<keycode>. char 0xd = Return,
  0x40000 = Control, 0x20000 = Shift, keycode 0x24 = Return.

  Applied by apply-keymap.sh, which merges these into the live GlobalKeyMap
  without touching iTerm2's own defaults. This is the single source of truth.
-->
<plist version="1.0">
<dict>
	<key>0xd-0x40000-0x24</key>
	<dict>
		<key>Action</key><integer>10</integer>
		<key>Apply Mode</key><integer>0</integer>
		<key>Escaping</key><integer>2</integer>
		<key>Text</key><string>[13;5u</string>
		<key>Version</key><integer>2</integer>
	</dict>
	<key>0xd-0x20000-0x24</key>
	<dict>
		<key>Action</key><integer>10</integer>
		<key>Apply Mode</key><integer>0</integer>
		<key>Escaping</key><integer>2</integer>
		<key>Text</key><string>[13;2u</string>
		<key>Version</key><integer>2</integer>
	</dict>
</dict>
</plist>
